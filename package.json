{
  "name": "@nh-kng/react-native-heroui",
  "version": "0.1.0",
  "description": "Native UI primitives for Expo and React Native",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android",
    "build",
    "expo-module.config.json",
    "internal/module_scripts",
    "ios",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js --passWithNoTests --watchman=false",
    "prepare": "node internal/module_scripts/prepare.js",
    "check": "npm run build && npm run lint && npm test -- --runInBand",
    "prepublishOnly": "npm run build",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "native-ui",
    "heroui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.86.3",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.3",
    "babel-preset-expo": "~57.0.16",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^57.0.31",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": ">=57.0.0",
    "react": ">=19.2.3",
    "react-native": ">=0.86.0"
  }
}
