  "description": "Source-owned cross-platform HeroUI components for Expo and React Native",
  "main": "./build/web/index.web.js",
  "types": "./build/web/index.web.d.ts",
  "packageManager": "pnpm@10.32.1",
  "files": [
    "build/web",
    "build/native",
    "styles",
    "docs/README.md",
    "docs/api",
    "docs/architecture/overview.md",
    "docs/architecture/decisions",
    "docs/development",
    "docs/getting-started",
    "docs/guides/platform-support.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "package.json",
    "docs/upstream",
    "docs/changes/archive"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.web.json && tsc -p tsconfig.native.json",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.native.json --noEmit",
    "typecheck:fixtures": "tsc -p tests/fixtures/tsconfig.web.json --noEmit && tsc -p tests/fixtures/tsconfig.native.json --noEmit",
    "watch": "node scripts/watch.mjs",
    "lint": "eslint src/",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run verify:upstream && pnpm run verify:owned && pnpm run typecheck && pnpm run typecheck:baselines && pnpm run lint && pnpm run build && pnpm run typecheck:fixtures && pnpm run build:baselines && pnpm test",
    "prepublishOnly": "pnpm run build",
    "build:baselines": "node scripts/build-baselines.mjs",
    "typecheck:baselines": "tsc -p tsconfig.baselines.web.json --noEmit && tsc -p tsconfig.baselines.native.json --noEmit",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "verify:owned": "node scripts/verify-owned.mjs"
  },
  "keywords": [
    "react-native",
    "expo",
    "native-ui",
    "heroui"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
